{
  "$description": "JAPS Studio — sistema visual Encastre v1.0. Formato W3C Design Tokens (DTCG). Fuente de verdad de theme.css.",
  "color": {
    "primitive": {
      "$type": "color",
      "paper":      { "$value": "#F1F3F0", "$description": "Carcasa clara" },
      "surface":    { "$value": "#FFFFFF", "$description": "Paneles y cards en claro" },
      "mist":       { "$value": "#DDE3DF", "$description": "Superficie secundaria clara; inverso en dark" },
      "ink":        { "$value": "#0D1110", "$description": "Texto, sidebar, carcasa oscura" },
      "ink-2":      { "$value": "#121816", "$description": "Fondo de shell oscuro" },
      "graphite":   { "$value": "#1A2421", "$description": "Paneles y cards en oscuro" },
      "graphite-2": { "$value": "#24302C", "$description": "Superficie secundaria oscura" },
      "slate":      { "$value": "#56625D", "$description": "Texto secundario en claro (5.7:1 sobre paper)" },
      "sage":       { "$value": "#4F6B62", "$description": "Panel hero (ref. 12)" },
      "sage-soft":  { "$value": "#A9BDB5", "$description": "Texto secundario en oscuro (8.1:1 sobre graphite)" },
      "mint":       { "$value": "#7FE3AE", "$description": "Acento 10 %. Nunca como texto sobre claro" },
      "mint-deep":  { "$value": "#4CC98A", "$description": "Hover y pressed del acento" },
      "mint-ink":   { "$value": "#1F7A55", "$description": "Acento como texto o icono sobre claro (5.3:1 sobre surface)" },
      "signal":     { "$value": "#FF5B1F", "$description": "Señal ≤2 %: live o alerta. Solo como relleno con texto ink" }
    },
    "light": {
      "$type": "color",
      "shell":           { "$value": "{color.primitive.paper}" },
      "surface":         { "$value": "{color.primitive.surface}" },
      "surface-2":       { "$value": "{color.primitive.mist}" },
      "panel":           { "$value": "{color.primitive.sage}" },
      "inverse":         { "$value": "{color.primitive.ink}" },
      "text":            { "$value": "{color.primitive.ink}" },
      "text-muted":      { "$value": "{color.primitive.slate}" },
      "text-on-panel":   { "$value": "{color.primitive.paper}" },
      "text-on-inverse": { "$value": "{color.primitive.paper}" },
      "text-on-accent":  { "$value": "{color.primitive.ink}" },
      "accent":          { "$value": "{color.primitive.mint}" },
      "accent-hover":    { "$value": "{color.primitive.mint-deep}" },
      "accent-text":     { "$value": "{color.primitive.mint-ink}" },
      "signal":          { "$value": "{color.primitive.signal}" },
      "hairline":        { "$value": "#0D11101F", "$description": "ink al 12 %" },
      "hairline-strong": { "$value": "#0D111066", "$description": "ink al 40 %" },
      "glass":           { "$value": "#FFFFFF24", "$description": "blanco al 14 %, solo sobre imagen" },
      "glass-border":    { "$value": "#FFFFFF2E", "$description": "blanco al 18 %" },
      "focus":           { "$value": "{color.primitive.mint-ink}" },
      "focus-on-panel":  { "$value": "{color.primitive.mint}", "$description": "Foco dentro del panel sage (3.74:1)" }
    },
    "dark": {
      "$type": "color",
      "shell":           { "$value": "{color.primitive.ink}" },
      "surface":         { "$value": "{color.primitive.graphite}" },
      "surface-2":       { "$value": "{color.primitive.graphite-2}" },
      "panel":           { "$value": "{color.primitive.sage}" },
      "inverse":         { "$value": "{color.primitive.mist}" },
      "text":            { "$value": "{color.primitive.paper}" },
      "text-muted":      { "$value": "{color.primitive.sage-soft}" },
      "text-on-panel":   { "$value": "{color.primitive.paper}" },
      "text-on-inverse": { "$value": "{color.primitive.ink}" },
      "text-on-accent":  { "$value": "{color.primitive.ink}" },
      "accent":          { "$value": "{color.primitive.mint}" },
      "accent-hover":    { "$value": "{color.primitive.mint-deep}" },
      "accent-text":     { "$value": "{color.primitive.mint}" },
      "signal":          { "$value": "{color.primitive.signal}" },
      "hairline":        { "$value": "#F1F3F01A", "$description": "paper al 10 %" },
      "hairline-strong": { "$value": "#F1F3F059", "$description": "paper al 35 %" },
      "glass":           { "$value": "#FFFFFF14", "$description": "blanco al 8 %, solo sobre imagen" },
      "glass-border":    { "$value": "#FFFFFF24", "$description": "blanco al 14 %" },
      "focus":           { "$value": "{color.primitive.mint}" },
      "focus-on-panel":  { "$value": "{color.primitive.mint}", "$description": "Foco dentro del panel sage (3.74:1)" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Archivo", "system-ui", "sans-serif"] },
      "body":    { "$value": ["Geist", "system-ui", "sans-serif"] },
      "mono":    { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":   { "$value": 400 },
      "medium":    { "$value": 500 },
      "semibold":  { "$value": 600 },
      "bold":      { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "width": {
      "$type": "number",
      "$description": "Eje wdth de Archivo (font-stretch %)",
      "normal":   { "$value": 100 },
      "expanded": { "$value": 125 }
    },
    "size": {
      "$type": "dimension",
      "$description": "min / max para clamp() entre 360 y 1440 px de viewport",
      "display-xl": { "$value": { "min": "44px", "max": "128px" } },
      "display-l":  { "$value": { "min": "40px", "max": "88px" } },
      "h1":         { "$value": { "min": "32px", "max": "56px" } },
      "h2":         { "$value": { "min": "24px", "max": "40px" } },
      "h3":         { "$value": { "min": "20px", "max": "28px" } },
      "body-l":     { "$value": "18px" },
      "body":       { "$value": "16px" },
      "small":      { "$value": "14px" },
      "label":      { "$value": "12px" },
      "micro":      { "$value": "11px" }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.92 },
      "heading": { "$value": 1.1 },
      "body":    { "$value": 1.6 },
      "label":   { "$value": 1.3 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": "-0.02em" },
      "heading": { "$value": "-0.01em" },
      "body":    { "$value": "0em" },
      "label":   { "$value": "0.08em" }
    }
  },
  "typography": {
    "$type": "typography",
    "statement": {
      "$description": "Mayúsculas expandidas tipo 'WE BUILD DIGITAL' (ref. 12)",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.extrabold}", "fontSize": "{font.size.display-xl}", "lineHeight": "{font.line-height.display}", "letterSpacing": "{font.letter-spacing.display}" }
    },
    "headline": {
      "$description": "Caja mixta tipo 'Futuristic technologies' (ref. 21)",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.display-l}", "lineHeight": "{font.line-height.display}", "letterSpacing": "{font.letter-spacing.display}" }
    },
    "h1":    { "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.h1}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "h2":    { "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.h2}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "h3":    { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.h3}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.body}" } },
    "body":  { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.body}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.body}" } },
    "small": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.small}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.body}" } },
    "label": {
      "$description": "HUD: mayúsculas, índices, seriales",
      "$value": { "fontFamily": "{font.family.mono}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.label}", "lineHeight": "{font.line-height.label}", "letterSpacing": "{font.letter-spacing.label}" }
    }
  },
  "space": {
    "$type": "dimension",
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "24px" },
    "6":  { "$value": "32px" },
    "7":  { "$value": "48px" },
    "8":  { "$value": "64px" },
    "9":  { "$value": "96px" },
    "10": { "$value": "128px" }
  },
  "gap": {
    "$type": "dimension",
    "$description": "Hueco estructural: entre paneles y entre muesca y elemento alojado",
    "desktop": { "$value": "12px" },
    "mobile":  { "$value": "8px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Concéntricos: interior = exterior − gap",
    "shell": { "$value": "40px" },
    "panel": { "$value": "28px" },
    "card":  { "$value": "16px" },
    "inner": { "$value": "8px" },
    "pill":  { "$value": "999px" }
  },
  "notch": {
    "$type": "dimension",
    "$description": "Muesca con filete inverso. El radio del filete es siempre radius.panel",
    "fillet": { "$value": "{radius.panel}" },
    "gap":    { "$value": "{gap.desktop}" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "strong":   { "$value": "1.5px" },
    "focus":    { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Única sombra permitida: popovers y menús flotantes",
    "float": { "$value": { "color": "#0D111024", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
  },
  "blur": {
    "$type": "dimension",
    "glass": { "$value": "16px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "120ms" },
      "fast":    { "$value": "200ms" },
      "base":    { "$value": "320ms" },
      "slow":    { "$value": "560ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] },
      "exit":     { "$value": [0.4, 0, 1, 1] }
    }
  },
  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "1440px" },
    "sidebar":   { "$value": "72px" },
    "measure":   { "$value": "68ch" }
  }
}
