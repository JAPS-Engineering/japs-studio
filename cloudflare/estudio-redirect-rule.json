{
  "description": "estudio.japs.ing → studio.japs.ing",
  "expression": "(http.host eq \"estudio.japs.ing\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://studio.japs.ing\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
